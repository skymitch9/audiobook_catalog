rules_version = '2';

// ============================================================================
// TRUST MODEL — read this before tightening anything.
//
// Until 2026-08-14 this site was auth-free: identity.js v1 signed out of
// Firebase Auth immediately after capturing the Google profile, request.auth
// was ALWAYS null, and these rules could enforce document SHAPE and nothing
// else. identity v2 (2026-08-14) keeps the Firebase session LIVE, so
// request.auth now carries a real uid for signed-in Google users — and these
// rules use it in exactly TWO places: club manager/moderator enforcement
// (see the "Club manager enforcement" helpers below, incl. the three-tier
// site_roles model) and the site-admin-only /reviews delete.
//
// Everything else keeps the shape-only model on purpose:
//   - reviews, club comments, quotes, TBR, progress, warnings and profiles
//     are MEANT to be writable by anyone who can load the page — including
//     legacy v1 sessions and server-side tools that call the REST API with
//     the public web key (request.auth null). Do not "fix" that openness.
//   - credential overwrite is not open (see /users), and neither is a wipe
//     that no client ever needed (see /reviews delete).
//
// ⚠️ TRANSITION SAFETY (the reason the club enforcement is claim-gated):
// rules are PROJECT-WIDE the moment they deploy — there is no dev lane for
// enforcement — while UI changes ride /dev/ until promoted. So every club
// clause below only enforces uids on clubs whose doc carries a NON-EMPTY
// managerUids map ("claimed" clubs). Clubs without one — every prod club
// today, and anything the old prod UI creates — behave exactly as before.
// Claiming is trust-on-first-use: while a club is unclaimed its doc update
// stays open (as it always was), so the first signed-in host stamps their
// own uid; abuse of that window is no worse than the status quo (anyone
// could already edit or delete the club), and the site admin is the repair
// path. The FUTURE tightening step (require claiming / gate more fields) is
// a separate deliberate deploy — see docs/TODO.md.
//
// Deletes that a normal member action performs (members, club content,
// reading lists, user warnings, cw_requests) stay open because no rule can
// bind a display name to a person. Accepted, documented residual risk.
//
// Audited end to end 2026-08-10; club/uid layer added 2026-08-14 against
// every writer in site/*.js, site/*.html, app/*.py and app/tools/*.py.
// Prod and *_dev rules must always stay in step.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Validation helpers (shared by prod and _dev lane collections) ----
    // The /dev/ Pages lane reads/writes *_dev collections (see site/fb-env.js)
    // so dev experiments never touch prod data. Rules are identical.

    function validLeaderboard() {
      return request.resource.data.playerName is string
             && request.resource.data.weekId is string;
    }

    function validUserCreate() {
      return request.resource.data.displayName is string
             && request.resource.data.passphraseHash is string;
    }

    function validReview() {
      return request.resource.data.displayName is string
             && request.resource.data.rating is number
             && request.resource.data.rating >= 0.5
             && request.resource.data.rating <= 5;
    }

    function validProfile() {
      return request.resource.data.displayName is string;
    }

    function validReadingList() {
      return request.resource.data.displayName is string
             && request.resource.data.bookId is string
             && request.resource.data.status is string;
    }

    function validClub() {
      return request.resource.data.name is string
             && request.resource.data.name.size() >= 3
             && request.resource.data.name.size() <= 40
             && request.resource.data.hostDisplayName is string;
    }

    function validClubMember() {
      return request.resource.data.displayName is string
             && request.resource.data.role in ['host', 'moderator', 'member'];
    }

    function validClubRead() {
      return request.resource.data.bookTitle is string
             && request.resource.data.status in ['active', 'finished', 'abandoned'];
    }

    // clubs/{id}/settings/* — currently the single doc `discord`, holding the
    // club's own Discord webhook URL (see site/clubs.js setClubDiscordWebhook).
    function validClubSettings() {
      return request.resource.data.webhookUrl is string
             && request.resource.data.webhookUrl.size() <= 300
             && request.resource.data.webhookUrl.matches('https://(discord|discordapp)\\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+')
             && request.resource.data.updatedBy is string;
    }

    // ---- Club manager enforcement (uid layer, 2026-08-14) ----
    //
    // The club doc may carry `managerUids`: a map of Firebase Auth uid ->
    // { role: 'host'|'moderator', displayName, claimedAt } recorded BESIDE
    // the display-name fields (hostSlug / members/{slug}.role), which remain
    // the presentation layer. A club with a non-empty map is "claimed" and
    // its manager-only writes require request.auth.uid in the map, or the
    // site admin. An unclaimed club behaves exactly as before the uid layer
    // existed — that is the migration path (see the header).

    function clubClaimed(club) {
      return ('managerUids' in club)
             && club.managerUids is map
             && club.managerUids.size() > 0;
    }

    function isClubManager(club) {
      return request.auth != null
             && clubClaimed(club)
             && request.auth.uid in club.managerUids;
    }

    // site_roles/{uid} — the site-wide roles, deliberately UNSUFFIXED
    // (one collection for both lanes, like pipeline_*): a role belongs to
    // the person, not the data lane. Written server-side only (the estate
    // auth Worker's site-roles endpoints, or scripts/seed_site_admin.py as
    // break-glass); browsers can never write it.
    //
    // THREE-tier model (owner matrix, 2026-08-14):
    //   'admin'     — everything: any club setting, roster, deletes, plus
    //                 site-wide review removal (see /reviews).
    //   'moderator' — the OPERATIONAL subset across ALL clubs: reading
    //                 schedule, polls management, next-meeting fields,
    //                 membership ops and content deletes. NOT features/
    //                 webhook/identity/roster/club-or-read deletes/site-wide.
    //   (club mods  — managerUids on the club doc: full powers over the
    //                 "club island" — book/reads, schedule, features,
    //                 joinMode, finish/abandon, ratings reveal, next
    //                 meeting — EXCEPT the two RESTRICTED fields below
    //                 (Discord webhook, managerUids itself), which are
    //                 site-admin only even for a bound host/mod, since
    //                 2026-08-16.)
    function siteRoleIs(r) {
      return request.auth != null
             && exists(/databases/$(database)/documents/site_roles/$(request.auth.uid))
             && get(/databases/$(database)/documents/site_roles/$(request.auth.uid)).data.role == r;
    }

    function isSiteAdmin() {
      return siteRoleIs('admin');
    }

    function isSiteModerator() {
      return siteRoleIs('moderator');
    }

    // The gate every STRUCTURAL manager-only club write goes through:
    // unclaimed club -> open (transition safety), else manager uid or admin.
    function canManageClub(club) {
      return !clubClaimed(club) || isClubManager(club) || isSiteAdmin();
    }

    // The OPERATIONAL gate: everything canManageClub admits, plus the site
    // moderator — people + content flow across all clubs (schedule, polls,
    // next meeting), never the structural fields below.
    function canOperateClub(club) {
      return canManageClub(club) || isSiteModerator();
    }

    // The RESTRICTED gate (2026-08-16 tightening, owner-approved): site
    // admin ONLY, never the club's own manager roster — not even a bound
    // host/mod. Guards the two fields that are either an outbound
    // CAPABILITY (the Discord webhook: whoever sets it decides where club
    // activity broadcasts) or PEER-ESCALATION (managerUids: a mod
    // appointing/removing other mods) — the same class the estate ladder
    // (docs/info/ROLES.md) outlaws with "grant only strictly beneath your
    // own role". Unclaimed clubs stay open (transition safety, same
    // migration path as canManageClub) since they predate the uid layer.
    // Deliberately does NOT admit isClubManager — that is the whole point
    // of this tier.
    function canAdministerClub(club) {
      return !clubClaimed(club) || isSiteAdmin();
    }

    // Parent club doc for subcollection rules. clubCol is 'clubs' or
    // 'clubs_dev' so prod and dev blocks share one implementation.
    function parentClub(clubCol, clubId) {
      return get(/databases/$(database)/documents/$(clubCol)/$(clubId)).data;
    }

    function validManagerUids() {
      return !('managerUids' in request.resource.data)
             || request.resource.data.managerUids is map;
    }

    // Club-doc fields only a manager may change once the club is claimed,
    // SPLIT by tier — three field-tiers as of 2026-08-16 (a separate
    // concept from the site_roles three-tier model above):
    //   STRUCTURAL  — canManageClub only (roster uid or site admin), the
    //     "club island" a mod runs day to day: joinMode, features.
    //   OPERATIONAL — canOperateClub (adds the site moderator):
    //     nextMeetingAt, nextMeetingNotes.
    //   RESTRICTED  — canAdministerClub (site admin only, NOT the club
    //     roster, 2026-08-16 tightening): discordWebhookMask, managerUids.
    //     See canAdministerClub's comment above for the rationale.
    // ⚠️ Keep these lists in step with STRUCTURAL_CLUB_FIELDS /
    // OPERATIONAL_CLUB_FIELDS / RESTRICTED_CLUB_FIELDS in site/clubs.js
    // (MANAGED_CLUB_FIELDS is their union; the test suite pins all four).
    // Everything else stays writable exactly as before, because member (and
    // legacy/anonymous) actions write the club doc too: joins/leaves touch
    // memberSlugs/invitedSlugs/memberCount, host-leave transfers touch
    // hostSlug/hostDisplayName/archived, reads touch activeSlots and the
    // avatar fields, and the Edit modal lets ANY member change
    // name/description/emoji/promptsEnabled. Those stay display-layer.
    function clubStructuralFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['joinMode', 'features']);
    }

    function clubOperationalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['nextMeetingAt', 'nextMeetingNotes']);
    }

    // RESTRICTED (2026-08-16): the Discord webhook mask and the manager
    // roster itself — site admin only, never a club mod. See
    // canAdministerClub() and RESTRICTED_CLUB_FIELDS in site/clubs.js.
    function clubRestrictedFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['discordWebhookMask', 'managerUids']);
    }

    // Read-doc fields gated the same way, split by tier:
    //   STRUCTURAL — club-level lifecycle (finish/abandon), slot, and the
    //     blind-ratings reveal flip (ratingsRevealed/revealedAt — see the
    //     ratings subcollection below): canManageClub only.
    //   OPERATIONAL — the reading schedule (milestones carry dueAt,
    //     scheduleUpdatedAt): canOperateClub, i.e. site moderator included.
    // commentCount (bumped by every commenter), slotLabel (member-editable)
    // and ratingCount (bumped by every rater, same open pattern as
    // commentCount) stay open, as does CREATE — starting a read is a
    // member action.
    // ⚠️ Keep these lists in step with STRUCTURAL_READ_FIELDS /
    // OPERATIONAL_READ_FIELDS in site/clubs.js.
    function readStructuralFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['status', 'finishedAt', 'slot', 'ratingsRevealed', 'revealedAt']);
    }

    function readOperationalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['milestones', 'scheduleUpdatedAt']);
    }

    // clubs/{id}/reads/{readId}/ratings/* — blind ratings reveal (backlog
    // #4). Doc id = member slug (progress/votes convention). Rating write
    // is open like progress (no rule can bind a display name to a person,
    // same residual-risk story as the rest of this trust model); READ is
    // the security control here:
    //
    // ⚠️ TRUST-MODEL CALL: this site's member identity has no auth binding
    // (see the file header) — a "read your own doc, deny others" rule is
    // NOT enforceable, because the doc id in the request path is just
    // whatever the client asks for; any browser that knows (or guesses) a
    // slug can request that exact path. Rules cannot tell "the owner" from
    // "anyone who typed the URL" without an auth uid on the doc, which
    // regular members don't have (only managerUids does). So instead of a
    // forgeable per-slug read rule, ratings are unreadable to EVERYONE
    // (including their own author) until the read is revealed — same
    // shape as the settings/{settingId} block above. The client mirrors
    // each member's own submitted rating into localStorage at write time
    // (site/club-reads.js) so they can see their own pick without a read;
    // that mirror is per-device and does not follow them to a second
    // browser during the blind window — an accepted, documented gap.
    //
    // "N members have rated" comes from ratingCount on the read doc itself
    // (open write, incremented on first rating per member — same pattern
    // as commentCount), NOT from reading this subcollection, so the count
    // stays visible through the blind window without leaking values.
    function validRating() {
      return request.resource.data.rating is number
             && request.resource.data.rating >= 0.5
             && request.resource.data.rating <= 5
             && request.resource.data.displayName is string;
    }

    // clubs/{id}/polls/* — free-form, optionally chapter-tagged polls
    // (backlog #3). Creation/close/delete are manager actions (enforced in
    // the UI, and on claimed clubs here too — same canManageClub gate as
    // reads/settings); voting stays open like progress writes (no rule can
    // bind a display name to a person, same residual-risk story as the rest
    // of this trust model).
    //
    // backlog #3b ('next book' poll type): an optional `type` field —
    // missing/undefined means 'freeform' (every poll written before this
    // shipped has no `type` at all, and an update() carries the existing
    // doc's fields forward into request.resource.data, so this MUST stay
    // backward compatible or closing/reopening a legacy poll would start
    // failing validPoll()). A 'nextBook' poll's `options` are book refs, not
    // strings — validated by validNextBookOptions/validBookOption below.
    // Rules have no generic "check every list element" construct, so the
    // check is written positionally, bounded by MAX_POLL_OPTIONS (10) —
    // cheap (no extra get()) and exact for a list this short.
    function validBookOption(opt) {
      return opt is map && opt.title is string && opt.title.size() > 0 && opt.title.size() <= 200;
    }

    function validNextBookOptions(opts) {
      return (opts.size() < 1 || validBookOption(opts[0]))
             && (opts.size() < 2 || validBookOption(opts[1]))
             && (opts.size() < 3 || validBookOption(opts[2]))
             && (opts.size() < 4 || validBookOption(opts[3]))
             && (opts.size() < 5 || validBookOption(opts[4]))
             && (opts.size() < 6 || validBookOption(opts[5]))
             && (opts.size() < 7 || validBookOption(opts[6]))
             && (opts.size() < 8 || validBookOption(opts[7]))
             && (opts.size() < 9 || validBookOption(opts[8]))
             && (opts.size() < 10 || validBookOption(opts[9]));
    }

    function validPoll() {
      return request.resource.data.question is string
             && request.resource.data.question.size() > 0
             && request.resource.data.question.size() <= 200
             && request.resource.data.options is list
             && request.resource.data.options.size() >= 2
             && request.resource.data.options.size() <= 10
             && request.resource.data.status in ['open', 'closed']
             && (!('type' in request.resource.data) || request.resource.data.type in ['freeform', 'nextBook'])
             && (!('type' in request.resource.data) || request.resource.data.type != 'nextBook'
                 || validNextBookOptions(request.resource.data.options));
    }

    function validPollVote() {
      return request.resource.data.optionIndex is int
             && request.resource.data.optionIndex >= 0
             && request.resource.data.displayName is string;
    }

    // clubs/{id}/rsvps/{memberSlug} — meeting scheduler RSVP (backlog #5).
    // One doc per member (doc id = slug, the progress/votes/ratings
    // convention). Write is open MEMBER-level, like poll votes and progress
    // — no rule here can bind a display name to a person, same residual-risk
    // story as the rest of this trust model. Read is open too (tally +
    // avatars render for everyone, like poll results).
    //
    // ⚠️ STALENESS: each response is stamped with `meetingAt` — the club's
    // nextMeetingAt epoch it was made FOR. Rescheduling or clearing the
    // meeting does NOT rewrite or delete existing rsvp docs (this trust
    // model has no manager-only bulk-delete rule to grant safely, and a
    // client-side loop over every member's doc would race the very read
    // it's trying to keep honest). Instead, every reader filters on
    // `meetingAt === club.nextMeetingAt` (site/club-reads.js
    // isRsvpCurrent/currentRsvps) before tallying or looking up "my
    // response" — a response for a stale instant simply never matches and
    // can never be counted against the current meeting. `meetingAt` is
    // therefore validated as a required number here so a forged doc can't
    // skip the field and accidentally count as "current" via `undefined`.
    function validRsvp() {
      return request.resource.data.response in ['going', 'maybe', 'cant']
             && request.resource.data.displayName is string
             && request.resource.data.meetingAt is number;
    }

    // Votes are refused once the poll is closed ("closing freezes it") —
    // one extra get() per vote write, same cost as the settings/reads
    // manager checks above.
    function parentPoll(clubCol, clubId, pollId) {
      return get(/databases/$(database)/documents/$(clubCol)/$(clubId)/polls/$(pollId)).data;
    }

    function pollIsOpen(clubCol, clubId, pollId) {
      return parentPoll(clubCol, clubId, pollId).status == 'open';
    }

    // Parent read doc, for the ratings-reveal gate below. `.get(key, default)`
    // dodges a missing-field error on reads created before this feature.
    function parentRead(clubCol, clubId, readId) {
      return get(/databases/$(database)/documents/$(clubCol)/$(clubId)/reads/$(readId)).data;
    }

    function ratingsRevealed(clubCol, clubId, readId) {
      return parentRead(clubCol, clubId, readId).get('ratingsRevealed', false) == true;
    }

    function validClubComment() {
      return request.resource.data.text is string
             && request.resource.data.text.size() > 0
             && request.resource.data.text.size() <= 2000
             && request.resource.data.displayName is string;
    }

    function validCwRequest() {
      return request.resource.data.bookTitle is string
             && request.resource.data.bookTitle.size() > 0
             && request.resource.data.bookTitle.size() <= 300
             && request.resource.data.requestedBy is string;
    }

    function validUserWarning() {
      return request.resource.data.label is string
             && request.resource.data.label.size() > 0
             && request.resource.data.label.size() <= 80
             && request.resource.data.bookId is string
             && request.resource.data.displayName is string;
    }

    // ---- Prod collections ----

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if validLeaderboard();
    }

    // ⚠️ PASSPHRASE ACCOUNTS ARE FROZEN — do not re-open `update` here.
    //
    // This block used to say `allow update: if true`, which was an account
    // takeover hole. User docs are world-readable and hold
    // { displayName, passphraseHash, createdAt }, so two unauthenticated calls
    // from any browser were enough: read a doc, PATCH its passphraseHash to the
    // SHA-256 of a passphrase you picked, then sign in as that person. That
    // includes the admin account (`!sky`, whose displayName '!Sky' is in
    // identity.js ADMIN_NAMES).
    //
    // The obvious fix, `request.auth.uid == userId`, is NOT available here.
    // site/identity.js captures the Google profile and then deliberately
    // signOut()s immediately (see signInWithGoogle's detach comment and
    // detachStaleFirebaseAuth), because a persisted token expiring mid-session
    // poisoned Firestore writes with PERMISSION_DENIED. request.auth is
    // therefore null on EVERY request this site makes.
    //
    // With world-readable docs and no auth there is nothing a rule can use to
    // tell the account owner from an attacker, so no secure passphrase-change
    // rule exists at all. Passphrase auth is retired — the whole collection is
    // three docs (`!sky`, `divaelf`, `test`), all superseded by Google SSO — so
    // the accounts are frozen instead:
    //   create : still allowed, so registration is not silently broken and the
    //            rule change cannot orphan a half-written flow.
    //   update : refused. Closes the takeover.
    //   delete : refused (it already was, implicitly — now explicit).
    //
    // `passwordReset` is refused along with everything else on purpose. Left
    // writable it would be destruction by another door: any visitor could flag
    // any account for reset, and since the matching setNewPassphrase() write is
    // now refused too, the account could never log in by passphrase again.
    //
    // KNOWN, DELIBERATE BREAKAGE: identity.js setNewPassphrase() and
    // adminResetPassword() — i.e. the admin.html "Reset Password" button — now
    // fail with PERMISSION_DENIED. Neither half of that flow can be made safe
    // without real auth, so both halves are off. Everything else that touches
    // /users is a read (login, register's name check, admin.html's user list).
    match /users/{userId} {
      allow read: if true;
      allow create: if validUserCreate();
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Open by design: anyone who can load the page may post or edit a review.
      // Split out from `allow write` only to make the delete rule below
      // unambiguous — the semantics of create/update are unchanged.
      allow create, update: if validReview();
      // Was `allow delete: if true`, i.e. any visitor could wipe all ~300
      // reviews with a loop, then `if false` (2026-08-10). Since the
      // three-tier model (2026-08-14) the SITE ADMIN — and only the site
      // admin, never the moderator, whose sweep is clubs-only by the owner's
      // matrix — may remove a review from the UI (reviews.js deleteReview).
      // Everyone else still cannot delete; the wipe-loop hole stays closed
      // because isSiteAdmin() requires a live uid with a site_roles doc.
      allow delete: if isSiteAdmin();
    }

    match /user_content_warnings/{docId} {
      allow read: if true;
      allow write: if validUserWarning();
      allow delete: if true;
    }

    // ⚠️ `allow delete: if true` is LOAD-BEARING and must stay.
    // app/tools/fetch_content_warnings.py clears fulfilled requests with a REST
    // DELETE authenticated by the *public web API key* (_fs_delete), not by the
    // service account — so it is gated by these rules like any browser. Closing
    // delete here would silently strand every fulfilled request.
    match /cw_requests/{docId} {
      allow read: if true;
      allow write: if validCwRequest();
      allow delete: if true;
    }

    match /club_seen/{userId} {
      allow read: if true;
      allow write: if request.resource.data.seen is map;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if validProfile();
    }

    match /readingLists/{docId} {
      allow read: if true;
      allow write: if validReadingList();
      allow delete: if true;
    }

    match /clubs/{clubId} {
      allow read: if true;
      // A club may be BORN claimed: the new UI stamps the creator's own uid
      // into managerUids at create when a live session exists. A roster on
      // create may only contain the caller's own uid; rosterless creates
      // (old prod UI, legacy sessions) keep working unchanged.
      allow create: if validClub() && validManagerUids()
                    && (!('managerUids' in request.resource.data)
                        || request.resource.data.managerUids.size() == 0
                        || (request.auth != null
                            && request.resource.data.managerUids.keys().hasOnly([request.auth.uid])));
      // Shape validation (was `if true` before 2026-08-10; see /users for the
      // create/update split story) PLUS, since 2026-08-14, the uid layer:
      // structural fields require canManageClub, operational fields (next
      // meeting) accept the site moderator too — both open while the club is
      // unclaimed, so every write path of the pre-uid UI still succeeds on
      // legacy clubs.
      //
      // Safe for every write path: on an update request.resource.data is the
      // POST-merge document, and every writer is a partial update
      // (updateDoc / tx.update in clubs.js + club-reads.js) or a full-fields
      // replace (app/tools/migrate_club.py put_doc), so name and
      // hostDisplayName survive.
      allow update: if validClub() && validManagerUids()
                    && (!clubStructuralFieldsChanged() || canManageClub(resource.data))
                    && (!clubOperationalFieldsChanged() || canOperateClub(resource.data))
                    && (!clubRestrictedFieldsChanged() || canAdministerClub(resource.data));
      // Open on unclaimed clubs (deleteClub was always a UI-gated member
      // action no rule could check); once claimed, only a manager uid or the
      // site admin may delete the club doc.
      allow delete: if canManageClub(resource.data);

      // ⚠️ Member-doc writes stay shape-only ON PURPOSE, including the role
      // field. Rules trust ONLY the club doc's managerUids for enforcement;
      // members/{slug}.role is presentation (it always was). Gating role
      // writes here would break the host-leave transfer (leaveClub tx.sets
      // the successor's member doc to role 'host', and the successor's uid
      // is unknowable at that moment) for no enforcement gain.
      match /members/{memberId} {
        allow read: if true;
        allow write: if validClubMember();
        allow delete: if true;
      }

      match /requests/{userId} {
        allow read: if true;
        allow write: if request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /tbr/{itemId} {
        allow read: if true;
        allow write: if request.resource.data.bookTitle is string
                     && request.resource.data.suggestedBy is string;
        allow delete: if true;
      }

      // ⚠️ `allow read: if false` is the security control, not an oversight —
      // same pattern as pipeline_requests. This doc holds the club's Discord
      // webhook URL, which is a CAPABILITY: anyone reading it can post to the
      // club's channel. Browsers write it and never read it back; the club
      // doc carries only a masked tail (discordWebhookMask) for display. The
      // server-side Discord notifier and the announcements engine read/write
      // here via the service account, which bypasses rules. Since 2026-08-14
      // writes and deletes were manager-gated once claimed; since 2026-08-16
      // that gate is RESTRICTED (canAdministerClub, site admin only) — a
      // bound club host/mod can no longer set or clear the webhook, because
      // it decides where club activity broadcasts (see canAdministerClub's
      // comment above).
      match /settings/{settingId} {
        allow read: if false;
        allow create, update: if validClubSettings()
                              && canAdministerClub(parentClub('clubs', clubId));
        allow delete: if canAdministerClub(parentClub('clubs', clubId));
      }

      // Untagged (club-wide) or read-section-tagged (see validPoll's caller,
      // site/club-reads.js createPoll) — either way lives directly under the
      // club, not nested under a read, since untagged polls have no read.
      // Polls management is OPERATIONAL (three-tier model): the site
      // moderator may create/close/delete polls in any club.
      match /polls/{pollId} {
        allow read: if true;
        allow create: if validPoll() && canOperateClub(parentClub('clubs', clubId));
        allow update: if validPoll() && canOperateClub(parentClub('clubs', clubId));
        allow delete: if canOperateClub(parentClub('clubs', clubId));

        match /votes/{userId} {
          allow read: if true;
          allow create, update: if validPollVote() && pollIsOpen('clubs', clubId, pollId);
          allow delete: if true;
        }
      }

      // See validRsvp() above for the staleness design (meetingAt-stamped,
      // filtered at read time — never rewritten on reschedule).
      match /rsvps/{userId} {
        allow read: if true;
        allow create, update: if validRsvp();
        allow delete: if true;
      }

      match /reads/{readId}/quotes/{quoteId} {
        allow read: if true;
        allow write: if request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 500
                     && request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /reads/{readId} {
        allow read: if true;
        // Create stays open: starting a read is a member action. Lifecycle
        // fields (readStructuralFieldsChanged) are manager actions once the
        // club is claimed; the reading schedule (operational) accepts the
        // site moderator too; commentCount bumps and slot labels stay open
        // for every member write path.
        allow create: if validClubRead();
        allow update: if validClubRead()
                      && (!readStructuralFieldsChanged()
                          || canManageClub(parentClub('clubs', clubId)))
                      && (!readOperationalFieldsChanged()
                          || canOperateClub(parentClub('clubs', clubId)));
        // Removing a read deletes discussions — manager UI action; gated
        // once the club is claimed, open (as it always was) before that.
        // Deliberately NOT canOperateClub: read deletes are structural.
        allow delete: if canManageClub(parentClub('clubs', clubId));

        match /comments/{commentId} {
          allow read: if true;
          allow create, update: if validClubComment();
          allow delete: if true;
        }

        match /progress/{userId} {
          allow read: if true;
          allow write: if request.resource.data.milestonePosition is number
                       || request.resource.data.chapterIndex is number;
        }

        // ⚠️ `allow read: if false`-until-revealed is the security control —
        // see the validRating() comment above for why a forgeable per-slug
        // read rule was rejected in favor of "nobody, not even the author,
        // until reveal". Create/update stay open (member action, like
        // progress); delete is open so removeRead()'s cleanup loop works.
        match /ratings/{userId} {
          allow read: if ratingsRevealed('clubs', clubId, readId);
          allow create, update: if validRating();
          allow delete: if true;
        }
      }
    }

    // ---- Dev lane collections (same shapes, separate data) ----

    match /leaderboard_dev/{docId} {
      allow read: if true;
      allow write: if validLeaderboard();
    }

    // Mirrors /users — see the takeover note there. Keep the two in step.
    match /users_dev/{userId} {
      allow read: if true;
      allow create: if validUserCreate();
      allow update, delete: if false;
    }

    match /reviews_dev/{reviewId} {
      allow read: if true;
      allow create, update: if validReview();
      allow delete: if isSiteAdmin();   // mirrors /reviews
    }

    match /user_content_warnings_dev/{docId} {
      allow read: if true;
      allow write: if validUserWarning();
      allow delete: if true;
    }

    // delete stays open — fetch_content_warnings.py clears this lane too.
    match /cw_requests_dev/{docId} {
      allow read: if true;
      allow write: if validCwRequest();
      allow delete: if true;
    }

    match /club_seen_dev/{userId} {
      allow read: if true;
      allow write: if request.resource.data.seen is map;
    }

    match /profiles_dev/{userId} {
      allow read: if true;
      allow write: if validProfile();
    }

    match /readingLists_dev/{docId} {
      allow read: if true;
      allow write: if validReadingList();
      allow delete: if true;
    }

    // Mirrors /clubs — see every note there, uid layer included. The
    // site_roles admin check is shared (one unsuffixed collection).
    match /clubs_dev/{clubId} {
      allow read: if true;
      allow create: if validClub() && validManagerUids()
                    && (!('managerUids' in request.resource.data)
                        || request.resource.data.managerUids.size() == 0
                        || (request.auth != null
                            && request.resource.data.managerUids.keys().hasOnly([request.auth.uid])));
      allow update: if validClub() && validManagerUids()
                    && (!clubStructuralFieldsChanged() || canManageClub(resource.data))
                    && (!clubOperationalFieldsChanged() || canOperateClub(resource.data))
                    && (!clubRestrictedFieldsChanged() || canAdministerClub(resource.data));
      allow delete: if canManageClub(resource.data);

      match /members/{memberId} {
        allow read: if true;
        allow write: if validClubMember();
        allow delete: if true;
      }

      match /requests/{userId} {
        allow read: if true;
        allow write: if request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /tbr/{itemId} {
        allow read: if true;
        allow write: if request.resource.data.bookTitle is string
                     && request.resource.data.suggestedBy is string;
        allow delete: if true;
      }

      // Mirrors /clubs/{clubId}/settings — see the capability note there.
      match /settings/{settingId} {
        allow read: if false;
        allow create, update: if validClubSettings()
                              && canAdministerClub(parentClub('clubs_dev', clubId));
        allow delete: if canAdministerClub(parentClub('clubs_dev', clubId));
      }

      // Mirrors /clubs/{clubId}/polls — see the capability/gating note there.
      match /polls/{pollId} {
        allow read: if true;
        allow create: if validPoll() && canOperateClub(parentClub('clubs_dev', clubId));
        allow update: if validPoll() && canOperateClub(parentClub('clubs_dev', clubId));
        allow delete: if canOperateClub(parentClub('clubs_dev', clubId));

        match /votes/{userId} {
          allow read: if true;
          allow create, update: if validPollVote() && pollIsOpen('clubs_dev', clubId, pollId);
          allow delete: if true;
        }
      }

      // Mirrors /clubs/{clubId}/rsvps — see validRsvp() for the staleness design.
      match /rsvps/{userId} {
        allow read: if true;
        allow create, update: if validRsvp();
        allow delete: if true;
      }

      match /reads/{readId}/quotes/{quoteId} {
        allow read: if true;
        allow write: if request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 500
                     && request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /reads/{readId} {
        allow read: if true;
        allow create: if validClubRead();
        allow update: if validClubRead()
                      && (!readStructuralFieldsChanged()
                          || canManageClub(parentClub('clubs_dev', clubId)))
                      && (!readOperationalFieldsChanged()
                          || canOperateClub(parentClub('clubs_dev', clubId)));
        allow delete: if canManageClub(parentClub('clubs_dev', clubId));

        match /comments/{commentId} {
          allow read: if true;
          allow create, update: if validClubComment();
          allow delete: if true;
        }

        match /progress/{userId} {
          allow read: if true;
          allow write: if request.resource.data.milestonePosition is number
                       || request.resource.data.chapterIndex is number;
        }

        // Mirrors /clubs/{clubId}/reads/{readId}/ratings — see the
        // validRating() comment for the trust-model reasoning.
        match /ratings/{userId} {
          allow read: if ratingsRevealed('clubs_dev', clubId, readId);
          allow create, update: if validRating();
          allow delete: if true;
        }
      }
    }

    // ---- Site roles (three-tier model; 2026-08-14) ----
    //
    // site_roles/{uid} = { role: 'admin'|'moderator', email, displayName,
    // grantedAt }. ONE unsuffixed collection for both lanes (like
    // pipeline_*): a role belongs to the person, not the data lane, and the
    // siteRoleIs() helpers above read it for prod and _dev clauses alike.
    //
    //   get   — only your OWN doc (doc id == request.auth.uid), so the UI
    //           can show "you are the site admin/moderator" without
    //           exposing a roster.
    //   list  — nobody. Enumerating who holds roles is a server-side concern
    //           (the estate auth Worker's GET /api/estate/site-roles, which
    //           reads via the service account and gates on approver).
    //   write — nobody from a browser. Written by the estate auth Worker's
    //           POST /api/estate/site-roles (the UI grant path) or
    //           scripts/seed_site_admin.py (break-glass), both through the
    //           service account, which bypasses these rules.
    match /site_roles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // ---- Pipeline status & remote trigger (prod + _dev) ----
    //
    // Written by the sync pipeline on the home machine via a Firebase service
    // account, which bypasses these rules entirely. So for CLIENTS:
    //
    //   pipeline_status / pipeline_runs — read-only. Nobody can forge a run.
    //   pipeline_requests              — CREATE-ONLY, AND DELIBERATELY UNREADABLE.
    //
    // The unreadable part is the security control, not an oversight. This
    // project has no server-side auth (no request.auth anywhere — "admin" is a
    // client-side displayName check), so rules cannot tell the admin from
    // anyone else. A request doc therefore carries a shared secret that only
    // the admin's browser holds, and the watcher on the home machine refuses
    // to act unless it matches. Making the collection unreadable is what stops
    // a passer-by harvesting that token out of a pending request and replaying
    // it to spin up runs on a private machine. Do not add `allow read` here.
    //
    // Worst case for an attacker who knows the schema: they can write junk
    // docs that the watcher ignores and deletes. No execution, no disclosure.

    function validPipelineRequest() {
      return request.resource.data.token is string
             && request.resource.data.token.size() >= 16
             && request.resource.data.token.size() <= 200
             && request.resource.data.requestedAt is string
             && request.resource.data.requestedBy is string
             && request.resource.data.requestedBy.size() <= 80;
    }

    match /pipeline_status/{docId} {
      allow read: if true;
      allow write: if false;   // service account only
    }

    match /pipeline_runs/{runId} {
      allow read: if true;
      allow write: if false;   // service account only
    }

    match /pipeline_requests/{reqId} {
      allow read: if false;    // see note above — do not relax
      allow create: if validPipelineRequest();
      allow update, delete: if false;
    }

    match /pipeline_status_dev/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /pipeline_runs_dev/{runId} {
      allow read: if true;
      allow write: if false;
    }

    match /pipeline_requests_dev/{reqId} {
      allow read: if false;
      allow create: if validPipelineRequest();
      allow update, delete: if false;
    }
  }
}
