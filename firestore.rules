rules_version = '2';

// ============================================================================
// TRUST MODEL — read this before tightening anything.
//
// Until 2026-08-14 this site was auth-free: identity.js v1 signed out of
// Firebase Auth immediately after capturing the Google profile, request.auth
// was ALWAYS null, and these rules could enforce document SHAPE and nothing
// else. identity v2 (2026-08-14) keeps the Firebase session LIVE, so
// request.auth now carries a real uid for signed-in Google users — and these
// rules use it in exactly TWO places: club manager/moderator enforcement
// (see the "Club manager enforcement" helpers below, incl. the three-tier
// site_roles model) and the site-admin-only /reviews delete.
//
// Everything else keeps the shape-only model on purpose:
//   - reviews, club comments, quotes, TBR, progress, warnings and profiles
//     are MEANT to be writable by anyone who can load the page — including
//     legacy v1 sessions and server-side tools that call the REST API with
//     the public web key (request.auth null). Do not "fix" that openness.
//   - credential overwrite is not open (see /users), and neither is a wipe
//     that no client ever needed (see /reviews delete).
//
// ⚠️ TRANSITION SAFETY (the reason the club enforcement is claim-gated):
// rules are PROJECT-WIDE the moment they deploy — there is no dev lane for
// enforcement — while UI changes ride /dev/ until promoted. So every club
// clause below only enforces uids on clubs whose doc carries a NON-EMPTY
// managerUids map ("claimed" clubs). Clubs without one — every prod club
// today, and anything the old prod UI creates — behave exactly as before.
// Claiming is trust-on-first-use: while a club is unclaimed its doc update
// stays open (as it always was), so the first signed-in host stamps their
// own uid; abuse of that window is no worse than the status quo (anyone
// could already edit or delete the club), and the site admin is the repair
// path. The FUTURE tightening step (require claiming / gate more fields) is
// a separate deliberate deploy — see docs/TODO.md.
//
// ⚠️ 2026-08-17 (owner-approved, the CLUB MANAGER package) narrowed the
// claim window and widened the island, in the same change:
//   - managerUids left the "open while unclaimed" pool. The only rankless
//     write that lands now is a SIGNED-IN person adding THEMSELVES to a club
//     with no managers — never a third party, never onto a claimed roster
//     (canWriteManagerRoster / selfOnlyManagerClaim below). A second manager
//     arrives only by a site moderator's or admin's hand.
//   - a club's own bound managers got their club's Discord webhook back
//     (canAdministerClub), which 2026-08-16 had taken to site-admin-only.
// Net: less open than yesterday on the roster, more delegated on the club.
//
// Deletes that a normal member action performs (members, club content,
// reading lists, cw_requests) stay open because no rule can bind a display
// name to a person. Accepted, documented residual risk.
//
// ⚠️ ONE EXCEPTION, 2026-08-17 (owner-approved): user_content_warnings
// delete is no longer open. It is author-or-moderator, bound by an
// `authorUid` field the client now stamps at write time — see
// canDeleteUserWarning() below for the whole story, including what it
// deliberately does NOT protect.
//
// ⚠️ A SECOND EXCEPTION, 2026-08-17 (owner: "for reading ebooks we also need
// to have it save your spot"): /readingPositions (+ _dev) is OWNER-ONLY —
// get and write require request.auth and a doc id that starts with the
// caller's own uid; list is refused outright. It is not a loosening of the
// shape-only model but the first collection that never needed it: the
// reader's readership all hold verified Firebase ID tokens by construction
// (the Worker demands one for every byte), so there is no legacy uid-less
// population to strand. See ownsPositionDoc() below.
//
// ⚠️ A THIRD EXCEPTION, 2026-08-18 (owner: "Make tbr keyed to account"):
// /readingLists (+ _dev) is now OWNER-ONLY FOR WRITES on account-keyed
// documents. Unlike readingPositions this collection DID have a legacy
// uid-less population, and the 53 documents that could not be moved keep the
// old shape-only rules rather than being stranded — so this is the first
// collection running BOTH models at once, told apart by the shape of the
// document id. Reads stay world-open; three surfaces list the collection.
// See canWriteReadingList() below, which says all of that at length.
//
// Audited end to end 2026-08-10; club/uid layer added 2026-08-14 against
// every writer in site/*.js, site/*.html, app/*.py and app/tools/*.py.
// Prod and *_dev rules must always stay in step.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Validation helpers (shared by prod and _dev lane collections) ----
    // The /dev/ Pages lane reads/writes *_dev collections (see site/fb-env.js)
    // so dev experiments never touch prod data. Rules are identical.

    function validLeaderboard() {
      return request.resource.data.playerName is string
             && request.resource.data.weekId is string;
    }

    function validUserCreate() {
      return request.resource.data.displayName is string
             && request.resource.data.passphraseHash is string;
    }

    function validReview() {
      return request.resource.data.displayName is string
             && request.resource.data.rating is number
             && request.resource.data.rating >= 0.5
             && request.resource.data.rating <= 5;
    }

    function validProfile() {
      return request.resource.data.displayName is string;
    }

    function validReadingList() {
      return request.resource.data.displayName is string
             && request.resource.data.bookId is string
             && request.resource.data.status is string;
    }

    // ---- Reading lists (TBR): ACCOUNT-keyed since 2026-08-18 ----
    //
    // Owner's order, verbatim: "Make tbr keyed to account".
    //
    // ⚠️ WHAT THIS FIXES. The id was `{displayNameLower}_{bookId}`, so two
    // members who choose the same display name shared one document per book —
    // each saw the other's intentions on their own list and could delete them.
    // The header above says a shape-only rule "can never bind a display name
    // to a person", and that is exactly right; the fix was therefore never a
    // rule, it was a KEY CHANGE plus a migration of the documents
    // (scripts/migrate_tbr_to_uid.py, 234 documents, 2026-08-18). These rules
    // are what stop the old hole being re-opened by a future writer.
    //
    // ⚠️ ONE COLLECTION, TWO LANES, AND THE ID SAYS WHICH. 181 documents moved
    // to `{uid}_{bookId}`. 53 could NOT: their owner is a retired v1
    // passphrase account with no Firebase uid to key to, and inventing one for
    // somebody's reading list was refused. So the old id must stay writable,
    // or those 53 become unreachable to the only person entitled to them —
    // the same "do not strand the legacy population" reasoning the file's
    // header applies everywhere else.
    //
    // The two lanes get different rules and CANNOT be confused for each other:
    //   account-keyed  id head is a 28-char uid  -> OWNER-ONLY, like a position
    //   legacy         anything else             -> shape-only, exactly as before
    //
    // ⚠️ WHY `read` STAYS OPEN. It always was, and three surfaces list this
    // whole collection (the site's own Reading-lists filter, community.html's
    // per-person counts, and the library catalog's My TBR). The order was to
    // key the list to an account, and that is what fixes the reported bug:
    // attribution is now exact, so a name-sharer's entries no longer appear on
    // your list and cannot be deleted by them. Making the collection unlistable
    // is a different, larger change that would break all three, and it was not
    // ordered. Stated here so nobody reads owner-only WRITES as owner-only
    // reads.

    // A Firebase uid is 28 characters of [A-Za-z0-9]. A legacy id starts with a
    // lowercased DISPLAY NAME, which across all 14 accounts and 234 documents
    // measured on migration day is shorter, longer, or contains a space or a
    // bracket. ⚠️ site/reviews.js `isUidKeyedListId` is the same predicate and
    // the two must agree — changing one alone silently re-opens the hole.
    function tbrIdIsUidKeyed(docId) {
      return docId.split('_')[0].size() == 28
             && docId.split('_')[0].matches('[A-Za-z0-9]+');
    }

    // Your own account-keyed document. Same shape as ownsPositionDoc, and the
    // `_` is load-bearing for the same reason: it is what reads the account
    // back out of the id. Neither half can contain one (a uid is alphanumeric,
    // a bookIdFromTitle slug is [a-z0-9-]).
    function ownsTbrDoc(docId) {
      return request.auth != null
             && docId.split('_')[0] == request.auth.uid;
    }

    // ⚠️ `.get(field, default)` throughout, never `field in data` followed by a
    // read: a missing field read directly ERRORS the whole expression rather
    // than failing one branch, which would turn an intended allow into a deny
    // (or worse, on a rewrite, the reverse).
    function tbrUid() {
      return request.resource.data.get('uid', '');
    }

    // A document may be written iff it is YOUR account-keyed one carrying YOUR
    // uid, or it is a legacy display-name one carrying NO uid.
    //
    // ⚠️ The uid FIELD and the uid in the ID must be the same account, and both
    // must be the caller. Two holes closed by that pairing: filing a document
    // under somebody else's id (denied — the id head is not your uid), and
    // filing one under your OWN id carrying somebody else's uid, which every
    // reader that trusts the field would then mis-attribute. Neither is
    // reachable without the other half.
    function canWriteReadingList(docId) {
      return validReadingList()
             && ((ownsTbrDoc(docId) && tbrUid() == request.auth.uid)
                 || (!tbrIdIsUidKeyed(docId) && tbrUid() == ''));
    }

    // ⚠️ Delete stays OPEN for legacy documents, and that is the same accepted
    // residual risk the file header records for reviews and club content: no
    // rule can bind a display name to a person, so there is nobody to check
    // against. It is NOT open for account-keyed ones — those are owner-only,
    // and that is the half the migration bought.
    function canDeleteReadingList(docId) {
      return ownsTbrDoc(docId)
             || (!tbrIdIsUidKeyed(docId) && resource.data.get('uid', '') == '');
    }

    // ---- Reading positions (the ebook reader's "save your spot") ----
    //
    // ⚠️ THE FIRST GENUINELY PER-PERSON COLLECTION IN THIS FILE, and the
    // exception to the trust model in the header rather than a contradiction
    // of it. Everything above is shape-only because it must keep working for
    // LEGACY v1 sessions that have no uid at all — a recorded owner decision
    // this file is told not to "fix". The reader has no such population: its
    // readers are, by construction, people who presented a verified Firebase
    // ID token to the Worker to get the bytes at all. So this one CAN be
    // locked to its owner, and is.
    //
    // Doc id is `${uid}_${bookId}` (site/reading-position.js positionDocId),
    // and reading the uid back out of it is what makes ownership enforceable
    // instead of advisory. Neither half can contain the separator: a Firebase
    // uid is alphanumeric, a bookIdFromTitle slug is [a-z0-9-].
    //
    //   get   — your OWN document only.
    //   list  — nobody. Enumerating what a household reads is not a query any
    //           client needs, and the collection holds one row per person per
    //           book. Same posture as site_roles.
    //   write — your OWN document, with a shape (below). Delete is yours too:
    //           "forget where I was" is a legitimate thing to want.
    //
    // ⚠️ `pos.kind` is REQUIRED, and that is a real guard rather than
    // paperwork: a CFI interpreted as a page number is a silent jump to the
    // wrong place, so a document whose locator has lost its type is refused
    // rather than stored. See site/reading-position.js §2.
    function ownsPositionDoc(docId) {
      return request.auth != null
             && docId.split('_')[0] == request.auth.uid;
    }

    function validReadingPosition() {
      return request.resource.data.uid == request.auth.uid
             && request.resource.data.bookId is string
             && request.resource.data.bookId.size() > 0
             && request.resource.data.format in ['pdf', 'epub']
             && request.resource.data.pos is map
             && request.resource.data.pos.kind in ['page', 'cfi']
             && request.resource.data.updatedAt is number;
    }

    function validClub() {
      return request.resource.data.name is string
             && request.resource.data.name.size() >= 3
             && request.resource.data.name.size() <= 40
             && request.resource.data.hostDisplayName is string;
    }

    function validClubMember() {
      return request.resource.data.displayName is string
             && request.resource.data.role in ['host', 'moderator', 'member'];
    }

    function validClubRead() {
      return request.resource.data.bookTitle is string
             && request.resource.data.status in ['active', 'finished', 'abandoned'];
    }

    // clubs/{id}/settings/* — currently the single doc `discord`, holding the
    // club's own Discord webhook URL (see site/clubs.js setClubDiscordWebhook).
    function validClubSettings() {
      return request.resource.data.webhookUrl is string
             && request.resource.data.webhookUrl.size() <= 300
             && request.resource.data.webhookUrl.matches('https://(discord|discordapp)\\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+')
             && request.resource.data.updatedBy is string;
    }

    // ---- Club manager enforcement (uid layer, 2026-08-14) ----
    //
    // The club doc may carry `managerUids`: a map of Firebase Auth uid ->
    // { role: 'host'|'moderator', displayName, claimedAt } recorded BESIDE
    // the display-name fields (hostSlug / members/{slug}.role), which remain
    // the presentation layer. A club with a non-empty map is "claimed" and
    // its manager-only writes require request.auth.uid in the map, or the
    // site admin. An unclaimed club behaves exactly as before the uid layer
    // existed — that is the migration path (see the header).

    function clubClaimed(club) {
      return ('managerUids' in club)
             && club.managerUids is map
             && club.managerUids.size() > 0;
    }

    function isClubManager(club) {
      return request.auth != null
             && clubClaimed(club)
             && request.auth.uid in club.managerUids;
    }

    // site_roles/{uid} — the site-wide roles, deliberately UNSUFFIXED
    // (one collection for both lanes, like pipeline_*): a role belongs to
    // the person, not the data lane. Written server-side only (the estate
    // auth Worker's site-roles endpoints, or scripts/seed_site_admin.py as
    // break-glass); browsers can never write it.
    //
    // THREE-tier model (owner matrix, 2026-08-14):
    //   'admin'     — everything: any club setting, roster, deletes, plus
    //                 site-wide review removal (see /reviews).
    //   'moderator' — the OPERATIONAL subset across ALL clubs: reading
    //                 schedule, polls management, next-meeting fields,
    //                 membership ops, content deletes and — since the
    //                 2026-08-17 MANAGECLUB SPLIT — the READ LIFECYCLE
    //                 (finish/abandon, remove a read, reveal its ratings).
    //                 NOT features/joinMode/webhook/identity/roster, and
    //                 NOT the CLUB delete, which stays the destructive row.
    //   (club mods  — managerUids on the club doc: full powers over the
    //                 "club island" — book/reads, schedule, features,
    //                 joinMode, finish/abandon, ratings reveal, next
    //                 meeting, AND (2026-08-17) their own club's Discord
    //                 webhook. The ONE thing a club mod may never touch is
    //                 managerUids itself: appointing co-managers is
    //                 peer-escalation. See canWriteManagerRoster below.)
    function siteRoleIs(r) {
      return request.auth != null
             && exists(/databases/$(database)/documents/site_roles/$(request.auth.uid))
             && get(/databases/$(database)/documents/site_roles/$(request.auth.uid)).data.role == r;
    }

    function isSiteAdmin() {
      return siteRoleIs('admin');
    }

    function isSiteModerator() {
      return siteRoleIs('moderator');
    }

    // The gate every STRUCTURAL manager-only club write goes through:
    // unclaimed club -> open (transition safety), else manager uid or admin.
    function canManageClub(club) {
      return !clubClaimed(club) || isClubManager(club) || isSiteAdmin();
    }

    // The OPERATIONAL gate: everything canManageClub admits, plus the site
    // moderator — people + content flow across all clubs (schedule, polls,
    // next meeting, and since 2026-08-17 the read lifecycle), never the
    // structural fields below and never the club delete.
    function canOperateClub(club) {
      return canManageClub(club) || isSiteModerator();
    }

    // The ADMINISTRATIVE gate — the club's own settings, chiefly the
    // Discord webhook.
    //
    // ⚠️ CHANGED 2026-08-17 (owner-approved, the CLUB MANAGER package): this
    // gate now ADMITS the club's own bound manager. The 2026-08-16
    // tightening had lumped the webhook together with managerUids as one
    // admin-only tier; the shadow soak then showed the surface was
    // unexercisable, and the reasoning did not survive the split — the two
    // fields are different animals:
    //   - the webhook is an outbound capability scoped to ONE club, held by
    //     the people who already run that club's reading. Delegable.
    //   - managerUids is who runs the club at all. Never delegable; it moved
    //     to canWriteManagerRoster() below, and a manager cannot touch it.
    // The site MODERATOR is admitted too, so the club island can never
    // out-rank the estate ladder: a bound manager may hold no site role at
    // all, and "moderators+ keep override everywhere" is the owner's rule.
    // Unclaimed clubs stay open (transition safety, as before).
    function canAdministerClub(club) {
      return !clubClaimed(club) || isClubManager(club)
             || isSiteModerator() || isSiteAdmin();
    }

    // The ROSTER gate — writes to managerUids itself, the one thing a club
    // manager may never do. Three arms, and only three:
    //
    //   1. THE CLAIM. A signed-in person may add THEMSELVES to a club that
    //      has no managers yet — first-come-first-served, the trust-on-
    //      first-use path the header describes, now bound: the post-merge
    //      roster must contain their uid AND NOTHING ELSE, so this arm can
    //      never add a third party and can never fire on a claimed club
    //      (whose post-merge map still carries the existing managers' keys).
    //   2 & 3. The OVERRIDE: site moderator or site admin, who may add
    //      anyone to any club. That is how a SECOND manager arrives —
    //      deliberately by an estate role's hand, never by a manager's own,
    //      because a manager appointing co-managers is the peer-escalation
    //      docs/info/ROLES.md outlaws with "grant only strictly beneath your
    //      own role".
    //
    // ⚠️ Note this is TIGHTER than what shipped before it, not looser: until
    // today an unclaimed club's managerUids was writable by ANYONE, signed
    // in or not (the whole doc was open while unclaimed). Now the only
    // rankless write that lands is a signed-in person claiming themselves.
    function selfOnlyManagerClaim() {
      return request.auth != null
             && !clubClaimed(resource.data)
             && request.resource.data.managerUids is map
             && request.resource.data.managerUids.keys().hasOnly([request.auth.uid]);
    }

    function canWriteManagerRoster() {
      return selfOnlyManagerClaim() || isSiteModerator() || isSiteAdmin();
    }

    // Parent club doc for subcollection rules. clubCol is 'clubs' or
    // 'clubs_dev' so prod and dev blocks share one implementation.
    function parentClub(clubCol, clubId) {
      return get(/databases/$(database)/documents/$(clubCol)/$(clubId)).data;
    }

    function validManagerUids() {
      return !('managerUids' in request.resource.data)
             || request.resource.data.managerUids is map;
    }

    // Club-doc fields only a manager may change once the club is claimed,
    // SPLIT by tier — three field-tiers as of 2026-08-16 (a separate
    // concept from the site_roles three-tier model above):
    //   STRUCTURAL  — canManageClub only (roster uid or site admin), the
    //     "club island" a mod runs day to day: joinMode, features.
    //   OPERATIONAL — canOperateClub (adds the site moderator):
    //     nextMeetingAt, nextMeetingNotes.
    //   ADMINISTERED — canAdministerClub (the club's own managers, plus
    //     site moderator/admin — 2026-08-17): discordWebhookMask.
    //   ROSTER      — canWriteManagerRoster (self-claim on an unclaimed
    //     club, or site moderator/admin — NEVER the club's own managers):
    //     managerUids. Split out of the old RESTRICTED tier on 2026-08-17;
    //     see canAdministerClub / canWriteManagerRoster above for why one
    //     tier could not describe both fields.
    // ⚠️ Keep these lists in step with STRUCTURAL_CLUB_FIELDS /
    // OPERATIONAL_CLUB_FIELDS / ADMINISTERED_CLUB_FIELDS /
    // ROSTER_CLUB_FIELDS in site/clubs.js (MANAGED_CLUB_FIELDS is their
    // union; the test suite pins them all).
    // Everything else stays writable exactly as before, because member (and
    // legacy/anonymous) actions write the club doc too: joins/leaves touch
    // memberSlugs/invitedSlugs/memberCount, host-leave transfers touch
    // hostSlug/hostDisplayName/archived, reads touch activeSlots and the
    // avatar fields, and the Edit modal lets ANY member change
    // name/description/emoji/promptsEnabled. Those stay display-layer.
    function clubStructuralFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['joinMode', 'features']);
    }

    function clubOperationalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['nextMeetingAt', 'nextMeetingNotes']);
    }

    // ADMINISTERED (2026-08-17): the Discord webhook's masked tail. The
    // club's own managers may change it; so may a site moderator/admin.
    function clubWebhookFieldChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['discordWebhookMask']);
    }

    // ROSTER (2026-08-17): managerUids itself — its own gate, because it is
    // the only club field whose writer decides who ELSE may write the rest.
    function clubManagerRosterChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['managerUids']);
    }

    // Read-doc fields gated the same way, split by tier — THREE tiers as of
    // the 2026-08-17 MANAGECLUB SPLIT (owner decision, option B):
    //   LIFECYCLE   — finishing/abandoning a read (status, finishedAt) and the
    //     blind-ratings reveal flip (ratingsRevealed/revealedAt — see the
    //     ratings subcollection below): canOperateClub, i.e. the club's own
    //     managers AND the site moderator. See below for why it moved.
    //   STRUCTURAL  — the slot ASSIGNMENT itself: canManageClub only.
    //   OPERATIONAL — the reading schedule (milestones carry dueAt,
    //     scheduleUpdatedAt): canOperateClub, i.e. site moderator included.
    // commentCount (bumped by every commenter), slotLabel (member-editable)
    // and ratingCount (bumped by every rater, same open pattern as
    // commentCount) stay open, as does CREATE — starting a read is a
    // member action.
    //
    // ⚠️ WHY LIFECYCLE LEFT STRUCTURAL (2026-08-17). The owner's line is
    // "running the reading" vs "destroying the thing": finishing a read,
    // removing one and revealing its ratings are the day-to-day work of
    // whoever runs a club, so they take the same gate as the schedule, the
    // polls and the membership ops. Deleting the CLUB and editing its
    // structure (joinMode, features) are the irreversible half and did NOT
    // move — canManageClub, site-admin floor, exactly as before.
    // The practical widening is the SITE MODERATOR: a club's own bound
    // managers already passed canManageClub, and now moderator+ passes too,
    // which is the "moderators+ keep override everywhere" rule the club
    // package established. scripts/smoke_club_manager_rules.py pins every arm.
    //
    // ⚠️ `slot` stays STRUCTURAL and is deliberately left behind. Measured
    // 2026-08-17 against site/club-reads.js: nothing UPDATES it — startRead
    // stamps it at create (open, a member action) and finish/remove edit the
    // CLUB's activeSlots array instead. So this tier guards re-slotting an
    // existing read, which no client does and no lifecycle action needs.
    //
    // ⚠️ Keep these lists in step with LIFECYCLE_READ_FIELDS /
    // STRUCTURAL_READ_FIELDS / OPERATIONAL_READ_FIELDS in site/clubs.js.
    function readLifecycleFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['status', 'finishedAt', 'ratingsRevealed', 'revealedAt']);
    }

    function readStructuralFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['slot']);
    }

    function readOperationalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['milestones', 'scheduleUpdatedAt']);
    }

    // clubs/{id}/reads/{readId}/ratings/* — blind ratings reveal (backlog
    // #4). Doc id = member slug (progress/votes convention). Rating write
    // is open like progress (no rule can bind a display name to a person,
    // same residual-risk story as the rest of this trust model); READ is
    // the security control here:
    //
    // ⚠️ TRUST-MODEL CALL: this site's member identity has no auth binding
    // (see the file header) — a "read your own doc, deny others" rule is
    // NOT enforceable, because the doc id in the request path is just
    // whatever the client asks for; any browser that knows (or guesses) a
    // slug can request that exact path. Rules cannot tell "the owner" from
    // "anyone who typed the URL" without an auth uid on the doc, which
    // regular members don't have (only managerUids does). So instead of a
    // forgeable per-slug read rule, ratings are unreadable to EVERYONE
    // (including their own author) until the read is revealed — same
    // shape as the settings/{settingId} block above. The client mirrors
    // each member's own submitted rating into localStorage at write time
    // (site/club-reads.js) so they can see their own pick without a read;
    // that mirror is per-device and does not follow them to a second
    // browser during the blind window — an accepted, documented gap.
    //
    // "N members have rated" comes from ratingCount on the read doc itself
    // (open write, incremented on first rating per member — same pattern
    // as commentCount), NOT from reading this subcollection, so the count
    // stays visible through the blind window without leaking values.
    function validRating() {
      return request.resource.data.rating is number
             && request.resource.data.rating >= 0.5
             && request.resource.data.rating <= 5
             && request.resource.data.displayName is string;
    }

    // clubs/{id}/polls/* — free-form, optionally chapter-tagged polls
    // (backlog #3). Creation/close/delete are manager actions (enforced in
    // the UI, and on claimed clubs here too — same canManageClub gate as
    // reads/settings); voting stays open like progress writes (no rule can
    // bind a display name to a person, same residual-risk story as the rest
    // of this trust model).
    //
    // backlog #3b ('next book' poll type): an optional `type` field —
    // missing/undefined means 'freeform' (every poll written before this
    // shipped has no `type` at all, and an update() carries the existing
    // doc's fields forward into request.resource.data, so this MUST stay
    // backward compatible or closing/reopening a legacy poll would start
    // failing validPoll()). A 'nextBook' poll's `options` are book refs, not
    // strings — validated by validNextBookOptions/validBookOption below.
    // Rules have no generic "check every list element" construct, so the
    // check is written positionally, bounded by MAX_POLL_OPTIONS (10) —
    // cheap (no extra get()) and exact for a list this short.
    function validBookOption(opt) {
      return opt is map && opt.title is string && opt.title.size() > 0 && opt.title.size() <= 200;
    }

    function validNextBookOptions(opts) {
      return (opts.size() < 1 || validBookOption(opts[0]))
             && (opts.size() < 2 || validBookOption(opts[1]))
             && (opts.size() < 3 || validBookOption(opts[2]))
             && (opts.size() < 4 || validBookOption(opts[3]))
             && (opts.size() < 5 || validBookOption(opts[4]))
             && (opts.size() < 6 || validBookOption(opts[5]))
             && (opts.size() < 7 || validBookOption(opts[6]))
             && (opts.size() < 8 || validBookOption(opts[7]))
             && (opts.size() < 9 || validBookOption(opts[8]))
             && (opts.size() < 10 || validBookOption(opts[9]));
    }

    function validPoll() {
      return request.resource.data.question is string
             && request.resource.data.question.size() > 0
             && request.resource.data.question.size() <= 200
             && request.resource.data.options is list
             && request.resource.data.options.size() >= 2
             && request.resource.data.options.size() <= 10
             && request.resource.data.status in ['open', 'closed']
             && (!('type' in request.resource.data) || request.resource.data.type in ['freeform', 'nextBook'])
             && (!('type' in request.resource.data) || request.resource.data.type != 'nextBook'
                 || validNextBookOptions(request.resource.data.options));
    }

    function validPollVote() {
      return request.resource.data.optionIndex is int
             && request.resource.data.optionIndex >= 0
             && request.resource.data.displayName is string;
    }

    // clubs/{id}/rsvps/{memberSlug} — meeting scheduler RSVP (backlog #5).
    // One doc per member (doc id = slug, the progress/votes/ratings
    // convention). Write is open MEMBER-level, like poll votes and progress
    // — no rule here can bind a display name to a person, same residual-risk
    // story as the rest of this trust model. Read is open too (tally +
    // avatars render for everyone, like poll results).
    //
    // ⚠️ STALENESS: each response is stamped with `meetingAt` — the club's
    // nextMeetingAt epoch it was made FOR. Rescheduling or clearing the
    // meeting does NOT rewrite or delete existing rsvp docs (this trust
    // model has no manager-only bulk-delete rule to grant safely, and a
    // client-side loop over every member's doc would race the very read
    // it's trying to keep honest). Instead, every reader filters on
    // `meetingAt === club.nextMeetingAt` (site/club-reads.js
    // isRsvpCurrent/currentRsvps) before tallying or looking up "my
    // response" — a response for a stale instant simply never matches and
    // can never be counted against the current meeting. `meetingAt` is
    // therefore validated as a required number here so a forged doc can't
    // skip the field and accidentally count as "current" via `undefined`.
    function validRsvp() {
      return request.resource.data.response in ['going', 'maybe', 'cant']
             && request.resource.data.displayName is string
             && request.resource.data.meetingAt is number;
    }

    // Votes are refused once the poll is closed ("closing freezes it") —
    // one extra get() per vote write, same cost as the settings/reads
    // manager checks above.
    function parentPoll(clubCol, clubId, pollId) {
      return get(/databases/$(database)/documents/$(clubCol)/$(clubId)/polls/$(pollId)).data;
    }

    function pollIsOpen(clubCol, clubId, pollId) {
      return parentPoll(clubCol, clubId, pollId).status == 'open';
    }

    // Parent read doc, for the ratings-reveal gate below. `.get(key, default)`
    // dodges a missing-field error on reads created before this feature.
    function parentRead(clubCol, clubId, readId) {
      return get(/databases/$(database)/documents/$(clubCol)/$(clubId)/reads/$(readId)).data;
    }

    function ratingsRevealed(clubCol, clubId, readId) {
      return parentRead(clubCol, clubId, readId).get('ratingsRevealed', false) == true;
    }

    function validClubComment() {
      return request.resource.data.text is string
             && request.resource.data.text.size() > 0
             && request.resource.data.text.size() <= 2000
             && request.resource.data.displayName is string;
    }

    function validCwRequest() {
      return request.resource.data.bookTitle is string
             && request.resource.data.bookTitle.size() > 0
             && request.resource.data.bookTitle.size() <= 300
             && request.resource.data.requestedBy is string;
    }

    // ---- Audiobook ingest queue (audio-player phase 0b, 2026-08-17) ----
    //
    // ⚠️ ONE DOCUMENT PER BOOK, and the doc id IS the dedupe. Owner: "my book
    // club reads a lot of the same books so 3 of us might request the same
    // book … add a duplicate clause." docId == bookId == the estate's
    // book_id_from_title fold, so a second press is an UPDATE that unions one
    // uid onto `requesters`, never a second row and never a second 600 MB
    // upload. See app/tools/fulfill_audio_requests.py for the whole contract.
    //
    // ⚠️ The doc id is the BOOK ID, not the file anchor, on purpose: the site
    // knows a book's title, never its path on the library machine, so it
    // cannot compute an anchor. The anchor is derived at upload time.
    function validAudioRequest() {
      return request.resource.data.bookTitle is string
             && request.resource.data.bookTitle.size() > 0
             && request.resource.data.bookTitle.size() <= 300
             && request.resource.data.bookId is string
             && request.resource.data.bookId.size() > 0
             && request.resource.data.requestedBy is string
             && request.resource.data.requesters is list
             && request.resource.data.requesters.size() <= 200;
    }

    // A NEW pile is opened by exactly one person: themselves.
    //
    // ⚠️ EXACT LIST EQUALITY, not `hasAll([uid])`. The live smoke test
    // (scripts/smoke_audio_request_rules.py, 2026-08-17) caught the weaker
    // form letting A open a pile that already contained "somebody-else" —
    // enrolling a person who never asked, and, worse, poisoning the pile so
    // the real second requester's legitimate join was then REFUSED (their
    // list did not contain the stranger). Written here as the incident that
    // produced the rule, because "requesters must contain you" reads correct
    // and is not.
    function audioRequestIsNewPile() {
      return request.auth != null
             && request.resource.data.requestedBy == request.auth.uid
             && request.resource.data.requesters == [request.auth.uid];
    }

    // A later requester JOINS the pile: they may add THEMSELVES and change
    // nothing else.
    //
    // ⚠️ The book a request names cannot be swapped after the fact: the
    // fulfiller uploads whatever `bookTitle` says, so an editable title on a
    // doc other people have already joined would let one requester redirect
    // everyone else's request at a different 600 MB file.
    //
    // ⚠️ The two list clauses are a pair and neither is redundant.
    // `hasAll(old)` forbids REMOVING an existing requester; `hasOnly(old +
    // me)` forbids ADDING anyone but yourself. Only one of them and the
    // other abuse walks straight through. Re-pressing when you are already
    // in the pile leaves the list unchanged, which both clauses accept — the
    // request stays idempotent.
    function audioRequestJoinsPile() {
      return request.auth != null
             && request.resource.data.requestedBy == resource.data.requestedBy
             && request.resource.data.bookId == resource.data.bookId
             && request.resource.data.bookTitle == resource.data.bookTitle
             && request.resource.data.requesters.hasAll(resource.data.requesters)
             && request.resource.data.requesters.hasOnly(
                  resource.data.requesters.concat([request.auth.uid]));
    }

    function validUserWarning() {
      return request.resource.data.label is string
             && request.resource.data.label.size() > 0
             && request.resource.data.label.size() <= 80
             && request.resource.data.bookId is string
             && request.resource.data.displayName is string;
    }

    // ---- Reader content-warning deletes (the 2026-08-17 split) ----
    //
    // Was `allow delete: if true`: ANY visitor could remove ANY reader's
    // content note. Un-offered by the UI, never enforced. Owner-approved
    // tightening: the AUTHOR or a site moderator+, split in the shadow
    // vocabulary as warning.selfDelete (member floor) and warning.modDelete
    // (moderator floor) — catalog-platform ACTION_GATES.
    //
    // ⚠️ THE BINDING IS A NEW FIELD, NOT AN EXISTING IDIOM. There is no
    // "author check" anywhere else in this file to copy: /reviews delete is
    // site-ADMIN-only precisely because a displayName-keyed doc proves
    // nothing (see the file header and the /reviews comment). So the client
    // (site/user-warnings.js) now stamps `authorUid` — the live Firebase uid
    // from identity.js getLiveUser() — beside displayName, and THAT is what
    // this compares. Deliberately NOT request.auth.token.name: Google lets
    // anyone set their display name to any string, so a name match would be
    // a spoofable gate dressed as a real one (the exact trap the 2026-08-16
    // isAdmin() rewrite removed).
    //
    // ⚠️ WHAT THIS DOES NOT PROTECT, on purpose:
    //   - Docs with NO authorUid (anything written before the client half
    //     promotes to prod, or by a legacy/mirror-only session) are
    //     moderator-deletable ONLY — their own author cannot remove them.
    //     Measured 2026-08-17 before deploying: BOTH lanes were EMPTY
    //     (0 docs, prod and _dev), so this stranded nothing. Re-adding the
    //     same note stamps authorUid and makes it self-deletable again.
    //   - Such an unstamped doc can still be CLAIMED (update authorUid to
    //     your own uid, then delete), because create/update stay shape-only
    //     by design. That is no worse than the `if true` it replaces, and
    //     warningAuthorUidStable() below stops it once a doc IS stamped.
    function warningAuthorIsRequester() {
      return request.auth != null
             && 'authorUid' in resource.data
             && resource.data.authorUid == request.auth.uid;
    }

    // Cheap check first: the author path costs no document reads, the role
    // path costs an exists()+get() on site_roles.
    function canDeleteUserWarning() {
      return warningAuthorIsRequester() || isSiteModerator() || isSiteAdmin();
    }

    // UPDATE only (resource is guaranteed to exist): a doc that already
    // carries an authorUid must keep exactly that one. Without this, the
    // open shape-only update would be a one-PATCH bypass of the delete rule
    // above — set authorUid to your own uid, then delete anyone's note.
    // Re-adding your own note (setDoc, same composite id) passes: same uid.
    function warningAuthorUidStable() {
      return !('authorUid' in resource.data)
             || (('authorUid' in request.resource.data)
                 && request.resource.data.authorUid == resource.data.authorUid);
    }

    // ---- Prod collections ----

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if validLeaderboard();
    }

    // ⚠️ PASSPHRASE ACCOUNTS ARE FROZEN — do not re-open `update` here.
    //
    // This block used to say `allow update: if true`, which was an account
    // takeover hole. User docs are world-readable and hold
    // { displayName, passphraseHash, createdAt }, so two unauthenticated calls
    // from any browser were enough: read a doc, PATCH its passphraseHash to the
    // SHA-256 of a passphrase you picked, then sign in as that person. That
    // includes the admin account (`!sky`, whose displayName '!Sky' is in
    // identity.js ADMIN_NAMES).
    //
    // The obvious fix, `request.auth.uid == userId`, is NOT available here.
    // site/identity.js captures the Google profile and then deliberately
    // signOut()s immediately (see signInWithGoogle's detach comment and
    // detachStaleFirebaseAuth), because a persisted token expiring mid-session
    // poisoned Firestore writes with PERMISSION_DENIED. request.auth is
    // therefore null on EVERY request this site makes.
    //
    // With world-readable docs and no auth there is nothing a rule can use to
    // tell the account owner from an attacker, so no secure passphrase-change
    // rule exists at all. Passphrase auth is retired — the whole collection is
    // three docs (`!sky`, `divaelf`, `test`), all superseded by Google SSO — so
    // the accounts are frozen instead:
    //   create : still allowed, so registration is not silently broken and the
    //            rule change cannot orphan a half-written flow.
    //   update : refused. Closes the takeover.
    //   delete : refused (it already was, implicitly — now explicit).
    //
    // `passwordReset` is refused along with everything else on purpose. Left
    // writable it would be destruction by another door: any visitor could flag
    // any account for reset, and since the matching setNewPassphrase() write is
    // now refused too, the account could never log in by passphrase again.
    //
    // KNOWN, DELIBERATE BREAKAGE: identity.js setNewPassphrase() and
    // adminResetPassword() — i.e. the admin.html "Reset Password" button — now
    // fail with PERMISSION_DENIED. Neither half of that flow can be made safe
    // without real auth, so both halves are off. Everything else that touches
    // /users is a read (login, register's name check, admin.html's user list).
    match /users/{userId} {
      allow read: if true;
      allow create: if validUserCreate();
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Open by design: anyone who can load the page may post or edit a review.
      // Split out from `allow write` only to make the delete rule below
      // unambiguous — the semantics of create/update are unchanged.
      allow create, update: if validReview();
      // Was `allow delete: if true`, i.e. any visitor could wipe all ~300
      // reviews with a loop, then `if false` (2026-08-10). Since the
      // three-tier model (2026-08-14) the SITE ADMIN — and only the site
      // admin, never the moderator, whose sweep is clubs-only by the owner's
      // matrix — may remove a review from the UI (reviews.js deleteReview).
      // Everyone else still cannot delete; the wipe-loop hole stays closed
      // because isSiteAdmin() requires a live uid with a site_roles doc.
      allow delete: if isSiteAdmin();
    }

    // Create/read unchanged (open by design, like reviews). Delete was
    // `if true` until 2026-08-17 — see canDeleteUserWarning() above.
    match /user_content_warnings/{docId} {
      allow read: if true;
      allow create: if validUserWarning();
      allow update: if validUserWarning() && warningAuthorUidStable();
      allow delete: if canDeleteUserWarning();
    }

    // ⚠️ `allow delete: if true` is LOAD-BEARING and must stay.
    // app/tools/fetch_content_warnings.py clears fulfilled requests with a REST
    // DELETE authenticated by the *public web API key* (_fs_delete), not by the
    // service account — so it is gated by these rules like any browser. Closing
    // delete here would silently strand every fulfilled request.
    match /cw_requests/{docId} {
      allow read: if true;
      allow write: if validCwRequest();
      allow delete: if true;
    }

    // The audiobook ingest queue. Mirrors cw_requests' seam exactly, because
    // it is the same seam: a browser enqueues, and the LOCAL pipeline (the
    // only machine holding 630 GB of audio) fulfils.
    //
    // ⚠️ `allow read: if true` is deliberate and, like cw_requests' open
    // delete, LOAD-BEARING. app/tools/fulfill_audio_requests.py LISTS this
    // collection over the REST API authenticated by the *public web API key*,
    // not a service account, so it is gated by these rules like any browser;
    // refusing list would strand every request with no error anywhere. What a
    // reader learns is a book title (already public in site/catalog.csv and
    // site/chapters.json, which stay public by owner decision) plus opaque
    // uids. ⚠️ If per-person privacy is ever wanted here, `requesters` must
    // move to a subcollection — narrowing this rule alone breaks the
    // fulfiller.
    //
    // ⚠️ `allow delete: if true` for the same reason it is open on
    // cw_requests: _clear_request() removes a fulfilled request with the
    // public key. Closing it makes every requested book re-upload every run.
    match /audio_requests/{docId} {
      allow read: if true;
      allow create: if validAudioRequest() && audioRequestIsNewPile();
      allow update: if validAudioRequest() && audioRequestJoinsPile();
      allow delete: if true;
    }

    match /club_seen/{userId} {
      allow read: if true;
      allow write: if request.resource.data.seen is map;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow write: if validProfile();
    }

    // Account-keyed since 2026-08-18 — see canWriteReadingList above for the
    // whole story, the legacy lane it deliberately keeps open, and why `read`
    // is still world-open.
    match /readingLists/{docId} {
      allow read: if true;
      allow create, update: if canWriteReadingList(docId);
      allow delete: if canDeleteReadingList(docId);
    }

    // Owner-only, both lanes. See ownsPositionDoc/validReadingPosition above.
    match /readingPositions/{docId} {
      allow get: if ownsPositionDoc(docId);
      allow list: if false;
      allow create, update: if ownsPositionDoc(docId) && validReadingPosition();
      allow delete: if ownsPositionDoc(docId);
    }

    match /clubs/{clubId} {
      allow read: if true;
      // A club may be BORN claimed: the new UI stamps the creator's own uid
      // into managerUids at create when a live session exists. A roster on
      // create may only contain the caller's own uid; rosterless creates
      // (old prod UI, legacy sessions) keep working unchanged.
      allow create: if validClub() && validManagerUids()
                    && (!('managerUids' in request.resource.data)
                        || request.resource.data.managerUids.size() == 0
                        || (request.auth != null
                            && request.resource.data.managerUids.keys().hasOnly([request.auth.uid])));
      // Shape validation (was `if true` before 2026-08-10; see /users for the
      // create/update split story) PLUS, since 2026-08-14, the uid layer:
      // structural fields require canManageClub, operational fields (next
      // meeting) accept the site moderator too — both open while the club is
      // unclaimed, so every write path of the pre-uid UI still succeeds on
      // legacy clubs. Since 2026-08-17 the old RESTRICTED clause is two:
      // the webhook mask (canAdministerClub, which the club's own managers
      // now hold) and managerUids (canWriteManagerRoster — self-claim on an
      // unclaimed club, or a site moderator/admin, never a club manager).
      //
      // Safe for every write path: on an update request.resource.data is the
      // POST-merge document, and every writer is a partial update
      // (updateDoc / tx.update in clubs.js + club-reads.js) or a full-fields
      // replace (app/tools/migrate_club.py put_doc), so name and
      // hostDisplayName survive.
      allow update: if validClub() && validManagerUids()
                    && (!clubStructuralFieldsChanged() || canManageClub(resource.data))
                    && (!clubOperationalFieldsChanged() || canOperateClub(resource.data))
                    && (!clubWebhookFieldChanged() || canAdministerClub(resource.data))
                    && (!clubManagerRosterChanged() || canWriteManagerRoster());
      // Open on unclaimed clubs (deleteClub was always a UI-gated member
      // action no rule could check); once claimed, only a manager uid or the
      // site admin may delete the club doc.
      allow delete: if canManageClub(resource.data);

      // ⚠️ Member-doc writes stay shape-only ON PURPOSE, including the role
      // field. Rules trust ONLY the club doc's managerUids for enforcement;
      // members/{slug}.role is presentation (it always was). Gating role
      // writes here would break the host-leave transfer (leaveClub tx.sets
      // the successor's member doc to role 'host', and the successor's uid
      // is unknowable at that moment) for no enforcement gain.
      match /members/{memberId} {
        allow read: if true;
        allow write: if validClubMember();
        allow delete: if true;
      }

      match /requests/{userId} {
        allow read: if true;
        allow write: if request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /tbr/{itemId} {
        allow read: if true;
        allow write: if request.resource.data.bookTitle is string
                     && request.resource.data.suggestedBy is string;
        allow delete: if true;
      }

      // ⚠️ `allow read: if false` is the security control, not an oversight —
      // same pattern as pipeline_requests. This doc holds the club's Discord
      // webhook URL, which is a CAPABILITY: anyone reading it can post to the
      // club's channel. Browsers write it and never read it back; the club
      // doc carries only a masked tail (discordWebhookMask) for display. The
      // server-side Discord notifier and the announcements engine read/write
      // here via the service account, which bypasses rules. Since 2026-08-14
      // writes and deletes are manager-gated once claimed; 2026-08-16 briefly
      // narrowed that to site admins only, and 2026-08-17 gave it back to the
      // club's own bound managers (plus site moderator/admin) — the webhook
      // is one club's outbound capability, run by the people who run that
      // club. See canAdministerClub's comment above for the whole argument.
      // The READ stays `if false` regardless of who may write it.
      match /settings/{settingId} {
        allow read: if false;
        allow create, update: if validClubSettings()
                              && canAdministerClub(parentClub('clubs', clubId));
        allow delete: if canAdministerClub(parentClub('clubs', clubId));
      }

      // Untagged (club-wide) or read-section-tagged (see validPoll's caller,
      // site/club-reads.js createPoll) — either way lives directly under the
      // club, not nested under a read, since untagged polls have no read.
      // Polls management is OPERATIONAL (three-tier model): the site
      // moderator may create/close/delete polls in any club.
      match /polls/{pollId} {
        allow read: if true;
        allow create: if validPoll() && canOperateClub(parentClub('clubs', clubId));
        allow update: if validPoll() && canOperateClub(parentClub('clubs', clubId));
        allow delete: if canOperateClub(parentClub('clubs', clubId));

        match /votes/{userId} {
          allow read: if true;
          allow create, update: if validPollVote() && pollIsOpen('clubs', clubId, pollId);
          allow delete: if true;
        }
      }

      // See validRsvp() above for the staleness design (meetingAt-stamped,
      // filtered at read time — never rewritten on reschedule).
      match /rsvps/{userId} {
        allow read: if true;
        allow create, update: if validRsvp();
        allow delete: if true;
      }

      match /reads/{readId}/quotes/{quoteId} {
        allow read: if true;
        allow write: if request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 500
                     && request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /reads/{readId} {
        allow read: if true;
        // Create stays open: starting a read is a member action. LIFECYCLE
        // fields (finish/abandon + the ratings reveal) take canOperateClub
        // since the 2026-08-17 MANAGECLUB SPLIT — the club's own managers, or
        // a site moderator; the slot ASSIGNMENT stays canManageClub; the
        // reading schedule (operational) accepts the site moderator too;
        // commentCount bumps and slot labels stay open for every member
        // write path.
        allow create: if validClubRead();
        allow update: if validClubRead()
                      && (!readLifecycleFieldsChanged()
                          || canOperateClub(parentClub('clubs', clubId)))
                      && (!readStructuralFieldsChanged()
                          || canManageClub(parentClub('clubs', clubId)))
                      && (!readOperationalFieldsChanged()
                          || canOperateClub(parentClub('clubs', clubId)));
        // Removing a read deletes its discussions — a manager UI action;
        // gated once the club is claimed, open (as it always was) before
        // that. ⚠️ canOperateClub since the 2026-08-17 MANAGECLUB SPLIT: this
        // clause used to read canManageClub with the note "read deletes are
        // structural", which the owner's option B overruled — removing a read
        // is running the club. The DESTRUCTIVE row is the club delete itself
        // (see /clubs/{clubId} above), and that one still takes canManageClub.
        allow delete: if canOperateClub(parentClub('clubs', clubId));

        match /comments/{commentId} {
          allow read: if true;
          allow create, update: if validClubComment();
          allow delete: if true;
        }

        match /progress/{userId} {
          allow read: if true;
          allow write: if request.resource.data.milestonePosition is number
                       || request.resource.data.chapterIndex is number;
        }

        // ⚠️ `allow read: if false`-until-revealed is the security control —
        // see the validRating() comment above for why a forgeable per-slug
        // read rule was rejected in favor of "nobody, not even the author,
        // until reveal". Create/update stay open (member action, like
        // progress); delete is open so removeRead()'s cleanup loop works.
        match /ratings/{userId} {
          allow read: if ratingsRevealed('clubs', clubId, readId);
          allow create, update: if validRating();
          allow delete: if true;
        }
      }
    }

    // ---- Dev lane collections (same shapes, separate data) ----

    match /leaderboard_dev/{docId} {
      allow read: if true;
      allow write: if validLeaderboard();
    }

    // Mirrors /users — see the takeover note there. Keep the two in step.
    match /users_dev/{userId} {
      allow read: if true;
      allow create: if validUserCreate();
      allow update, delete: if false;
    }

    match /reviews_dev/{reviewId} {
      allow read: if true;
      allow create, update: if validReview();
      allow delete: if isSiteAdmin();   // mirrors /reviews
    }

    match /user_content_warnings_dev/{docId} {
      allow read: if true;
      allow create: if validUserWarning();                                // mirrors
      allow update: if validUserWarning() && warningAuthorUidStable();    // /user_content_warnings
      allow delete: if canDeleteUserWarning();                            // keep in step
    }

    // delete stays open — fetch_content_warnings.py clears this lane too.
    match /cw_requests_dev/{docId} {
      allow read: if true;
      allow write: if validCwRequest();
      allow delete: if true;
    }

    // Mirrors /audio_requests — see every note there. The fulfiller reads
    // BOTH lanes in one pass, so a request made on /dev/ is still fulfilled.
    match /audio_requests_dev/{docId} {
      allow read: if true;
      allow create: if validAudioRequest() && audioRequestIsNewPile();
      allow update: if validAudioRequest() && audioRequestJoinsPile();
      allow delete: if true;
    }

    match /club_seen_dev/{userId} {
      allow read: if true;
      allow write: if request.resource.data.seen is map;
    }

    match /profiles_dev/{userId} {
      allow read: if true;
      allow write: if validProfile();
    }

    // Mirrors /readingLists — keep the two in step. ⚠️ Same note as
    // readingPositions_dev: the DATA lane is suffixed but the RULE is the same
    // rule. Ownership is not a lane property, and a dev-lane hole is a
    // prod-lane hole with a nicer name.
    match /readingLists_dev/{docId} {
      allow read: if true;
      allow create, update: if canWriteReadingList(docId);
      allow delete: if canDeleteReadingList(docId);
    }

    // Mirrors /readingPositions — keep the two in step. ⚠️ The DATA lane is
    // suffixed but the RULE is the same rule: ownership is not a lane
    // property, and a dev-lane hole is a prod-lane hole with a nicer name.
    match /readingPositions_dev/{docId} {
      allow get: if ownsPositionDoc(docId);
      allow list: if false;
      allow create, update: if ownsPositionDoc(docId) && validReadingPosition();
      allow delete: if ownsPositionDoc(docId);
    }

    // Mirrors /clubs — see every note there, uid layer included. The
    // site_roles admin check is shared (one unsuffixed collection).
    match /clubs_dev/{clubId} {
      allow read: if true;
      allow create: if validClub() && validManagerUids()
                    && (!('managerUids' in request.resource.data)
                        || request.resource.data.managerUids.size() == 0
                        || (request.auth != null
                            && request.resource.data.managerUids.keys().hasOnly([request.auth.uid])));
      allow update: if validClub() && validManagerUids()
                    && (!clubStructuralFieldsChanged() || canManageClub(resource.data))
                    && (!clubOperationalFieldsChanged() || canOperateClub(resource.data))
                    && (!clubWebhookFieldChanged() || canAdministerClub(resource.data))
                    && (!clubManagerRosterChanged() || canWriteManagerRoster());
      allow delete: if canManageClub(resource.data);

      match /members/{memberId} {
        allow read: if true;
        allow write: if validClubMember();
        allow delete: if true;
      }

      match /requests/{userId} {
        allow read: if true;
        allow write: if request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /tbr/{itemId} {
        allow read: if true;
        allow write: if request.resource.data.bookTitle is string
                     && request.resource.data.suggestedBy is string;
        allow delete: if true;
      }

      // Mirrors /clubs/{clubId}/settings — see the capability note there.
      match /settings/{settingId} {
        allow read: if false;
        allow create, update: if validClubSettings()
                              && canAdministerClub(parentClub('clubs_dev', clubId));
        allow delete: if canAdministerClub(parentClub('clubs_dev', clubId));
      }

      // Mirrors /clubs/{clubId}/polls — see the capability/gating note there.
      match /polls/{pollId} {
        allow read: if true;
        allow create: if validPoll() && canOperateClub(parentClub('clubs_dev', clubId));
        allow update: if validPoll() && canOperateClub(parentClub('clubs_dev', clubId));
        allow delete: if canOperateClub(parentClub('clubs_dev', clubId));

        match /votes/{userId} {
          allow read: if true;
          allow create, update: if validPollVote() && pollIsOpen('clubs_dev', clubId, pollId);
          allow delete: if true;
        }
      }

      // Mirrors /clubs/{clubId}/rsvps — see validRsvp() for the staleness design.
      match /rsvps/{userId} {
        allow read: if true;
        allow create, update: if validRsvp();
        allow delete: if true;
      }

      match /reads/{readId}/quotes/{quoteId} {
        allow read: if true;
        allow write: if request.resource.data.text is string
                     && request.resource.data.text.size() > 0
                     && request.resource.data.text.size() <= 500
                     && request.resource.data.displayName is string;
        allow delete: if true;
      }

      match /reads/{readId} {
        allow read: if true;
        // Same three tiers as the prod lane — see the /clubs/{clubId}/reads
        // block above for the 2026-08-17 MANAGECLUB SPLIT reasoning.
        allow create: if validClubRead();
        allow update: if validClubRead()
                      && (!readLifecycleFieldsChanged()
                          || canOperateClub(parentClub('clubs_dev', clubId)))
                      && (!readStructuralFieldsChanged()
                          || canManageClub(parentClub('clubs_dev', clubId)))
                      && (!readOperationalFieldsChanged()
                          || canOperateClub(parentClub('clubs_dev', clubId)));
        allow delete: if canOperateClub(parentClub('clubs_dev', clubId));

        match /comments/{commentId} {
          allow read: if true;
          allow create, update: if validClubComment();
          allow delete: if true;
        }

        match /progress/{userId} {
          allow read: if true;
          allow write: if request.resource.data.milestonePosition is number
                       || request.resource.data.chapterIndex is number;
        }

        // Mirrors /clubs/{clubId}/reads/{readId}/ratings — see the
        // validRating() comment for the trust-model reasoning.
        match /ratings/{userId} {
          allow read: if ratingsRevealed('clubs_dev', clubId, readId);
          allow create, update: if validRating();
          allow delete: if true;
        }
      }
    }

    // ---- Site roles (three-tier model; 2026-08-14) ----
    //
    // site_roles/{uid} = { role: 'admin'|'moderator', email, displayName,
    // grantedAt }. ONE unsuffixed collection for both lanes (like
    // pipeline_*): a role belongs to the person, not the data lane, and the
    // siteRoleIs() helpers above read it for prod and _dev clauses alike.
    //
    //   get   — only your OWN doc (doc id == request.auth.uid), so the UI
    //           can show "you are the site admin/moderator" without
    //           exposing a roster.
    //   list  — nobody. Enumerating who holds roles is a server-side concern
    //           (the estate auth Worker's GET /api/estate/site-roles, which
    //           reads via the service account and gates on approver).
    //   write — nobody from a browser. Written by the estate auth Worker's
    //           POST /api/estate/site-roles (the UI grant path) or
    //           scripts/seed_site_admin.py (break-glass), both through the
    //           service account, which bypasses these rules.
    match /site_roles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // ---- Pipeline status & remote trigger (prod + _dev) ----
    //
    // Written by the sync pipeline on the home machine via a Firebase service
    // account, which bypasses these rules entirely. So for CLIENTS:
    //
    //   pipeline_status / pipeline_runs — read-only. Nobody can forge a run.
    //   pipeline_requests              — CREATE-ONLY, AND DELIBERATELY UNREADABLE.
    //
    // The unreadable part is the security control, not an oversight. This
    // project has no server-side auth (no request.auth anywhere — "admin" is a
    // client-side displayName check), so rules cannot tell the admin from
    // anyone else. A request doc therefore carries a shared secret that only
    // the admin's browser holds, and the watcher on the home machine refuses
    // to act unless it matches. Making the collection unreadable is what stops
    // a passer-by harvesting that token out of a pending request and replaying
    // it to spin up runs on a private machine. Do not add `allow read` here.
    //
    // Worst case for an attacker who knows the schema: they can write junk
    // docs that the watcher ignores and deletes. No execution, no disclosure.

    // `step` (2026-08-16, fine-grained manual controls — catalog-platform
    // /status Operations section): OPTIONAL field naming ONE pipeline stage
    // to run instead of the whole thing, or the standalone
    // "force-upload-server" marker (scripts/sync_to_server.py — deliberately
    // not a pipeline stage). Bounded to the exact set app/tools/
    // pipeline_watcher.py and scripts/sync_to_drive.py's STEP_INFO
    // recognize — anything else is what a forged/malformed request would
    // carry, and the watcher already discards those, but the rule itself
    // should not admit garbage into the collection either. Absent/blank
    // means "run the whole pipeline" (unchanged, backward compatible with
    // every existing writer of this doc shape).
    function validPipelineStep() {
      return !('step' in request.resource.data)
             || request.resource.data.step in [
               'audit', 'sort', 'detect', 'folders', 'upload', 'catalog',
               'publish', 'force-upload-server'
             ];
    }

    function validPipelineRequest() {
      return request.resource.data.token is string
             && request.resource.data.token.size() >= 16
             && request.resource.data.token.size() <= 200
             && request.resource.data.requestedAt is string
             && request.resource.data.requestedBy is string
             && request.resource.data.requestedBy.size() <= 80
             && validPipelineStep();
    }

    match /pipeline_status/{docId} {
      allow read: if true;
      allow write: if false;   // service account only
    }

    match /pipeline_runs/{runId} {
      allow read: if true;
      allow write: if false;   // service account only
    }

    match /pipeline_requests/{reqId} {
      allow read: if false;    // see note above — do not relax
      allow create: if validPipelineRequest();
      allow update, delete: if false;
    }

    match /pipeline_status_dev/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /pipeline_runs_dev/{runId} {
      allow read: if true;
      allow write: if false;
    }

    match /pipeline_requests_dev/{reqId} {
      allow read: if false;
      allow create: if validPipelineRequest();
      allow update, delete: if false;
    }

    // ---- Shelf-server force-upload result (2026-08-16) ----
    //
    // scripts/sync_to_server.py's own status doc (app/pipeline_status.py's
    // force_upload_result()) — deliberately SEPARATE from pipeline_status/
    // pipeline_runs above, so a force-upload run can never masquerade as a
    // pipeline outcome on the status page's primary "Automated Book
    // Pipeline" row. Same read-open/write-service-account-only shape.
    match /shelf_upload_status/{docId} {
      allow read: if true;
      allow write: if false;   // service account only
    }

    match /shelf_upload_status_dev/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
